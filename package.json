{
    "name": "antique-appraiser-directory",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run check:static",
    "check:static": "npm run test:art-directory-consolidation && npm run check:interaction-contract && npm run assets:check && npm run test:assets && npm run check:static-city-heroes && npm run check:static-authoritative-city-shells && npm run check:conflicted-provider-terminal-contract && npm run check:city-provider-comparisons && npm run check:city-question-evidence && npm run check:unlinked-city-cards && node ./scripts/check-static-site.mjs --public-dir public_site && node ./scripts/validate-directory-consistency.mjs --public-dir public_site && node ../../tools/directory-site-utils/audit-provider-source-quality.mjs --source-dir src/data/standardized --manifest data/provider-publication-manifest.json --output /tmp/antique-provider-source-quality.json && node ./scripts/check-provider-trust-contract.mjs --public-dir public_site --manifest data/provider-publication-manifest.json && npm run check:limited-provider-artwork && node ./scripts/check-art-directory-recovery-links.mjs && npm run check:llm-trust-cohort && npm run check:cross-host-provider-truth && npm run check:canonical-link-ownership && node ./scripts/apply-provider-discovery-graph.mjs --public-dir public_site && node ./scripts/build-indexing-manifest.mjs --public-dir public_site --check && node ./scripts/check-indexing-contract.mjs --public-dir public_site && node ./scripts/repair-faq-schema.mjs --public-dir public_site --check && node ./scripts/repair-short-mobile-compositing.mjs --public-dir public_site --check && node ./scripts/repair-internal-location-links.mjs --public-dir public_site --check",
    "normalize:llm-trust-cohort": "node ../../tools/directory-site-utils/normalize-provider-trust-cohort.mjs --public-dir public_site --manifest data/provider-publication-manifest.json --cohort data/llm-reference-trust-cohort.json --write",
    "check:llm-trust-cohort": "node ../../tools/directory-site-utils/check-directory-trust-cohort.mjs --public-dir public_site --manifest data/provider-publication-manifest.json --cohort data/llm-reference-trust-cohort.json",
        "check:interaction-contract": "node ./scripts/check-interaction-contract.mjs",
        "check:directory-enrichment": "node ./scripts/check-directory-enrichment-contract.mjs --enforce",
        "test:art-directory-consolidation": "node --test ./tests/art-directory-consolidation.test.mjs",
        "test:directory-enrichment": "node --test ./tests/city-provider-comparison-modules.test.mjs ./tests/city-question-evidence.test.mjs ./tests/conflicted-provider-terminal-contract.test.mjs ./tests/directory-enrichment-contract.test.mjs ./tests/gsc-city-decision-utility.test.mjs ./tests/gsc-city-decision-utility-wave-2.test.mjs ./tests/gsc-city-decision-utility-wave-3.test.mjs ./tests/gsc-city-decision-utility-wave-4.test.mjs ./tests/gsc-city-decision-utility-wave-5.test.mjs ./tests/gsc-city-decision-utility-wave-6.test.mjs ./tests/gsc-city-decision-utility-wave-7.test.mjs ./tests/gsc-city-decision-utility-wave-8.test.mjs ./tests/static-authoritative-city-shell-completion.test.mjs ./tests/unlinked-city-card-quarantine.test.mjs ./tests/verification-updates-contract.test.mjs",
    "check:limited-provider-artwork": "node ./scripts/normalize-limited-provider-artwork.mjs --public-dir public_site --manifest data/provider-publication-manifest.json",
    "check:static-city-heroes": "node ./scripts/normalize-static-city-heroes.mjs --public-dir public_site",
    "check:static-authoritative-city-shells": "node ./scripts/migrate-static-authoritative-city-shells.mjs --public-dir public_site",
    "check:conflicted-provider-terminal-contract": "node ./scripts/check-conflicted-provider-terminal-contract.mjs --public-dir public_site --manifest data/provider-publication-manifest.json",
    "check:city-provider-comparisons": "node ./scripts/apply-city-provider-comparison-modules.mjs --public-dir public_site --manifest data/provider-publication-manifest.json",
    "check:city-question-evidence": "node ./scripts/enforce-city-question-evidence.mjs --public-dir public_site --policy data/city-question-evidence-policy.json",
    "check:unlinked-city-cards": "node ./scripts/quarantine-unlinked-city-cards.mjs --public-dir public_site",
    "assets:check": "node ./scripts/check-retired-image-provider.mjs && node ./scripts/test-retired-image-provider.mjs",
    "test:assets": "node ./scripts/test-asset-url-contract.mjs",
    "check:indexing-contract": "node ./scripts/check-indexing-contract.mjs --public-dir public_site",
        "check:canonical-link-ownership": "node ./scripts/check-canonical-link-ownership.mjs --public-dir public_site",
        "check:cross-host-provider-truth": "node ./scripts/check-cross-host-provider-truth.mjs --fail-on-conflicts",
        "recovery:suppress-cross-host-conflicts": "node ./scripts/suppress-cross-host-conflicts.mjs --public-dir public_site --write && npm run build:llm-feeds && npm run seo:indexing-manifest",
        "seo:indexing-manifest": "node ./scripts/build-indexing-manifest.mjs --public-dir public_site --write",
        "check:indexing-manifest": "node ./scripts/build-indexing-manifest.mjs --public-dir public_site --check",
        "preview": "node ./scripts/serve-static.js --public-dir public_site",
        "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "test:html": "node ./scripts/test-html.js --public-dir public_site",
        "serve:static": "node ./scripts/serve-static.js --public-dir public_site",
        "count:appraisers": "node ./scripts/count-appraisers.js",
        "build:llm-feeds": "node ./scripts/build-directory-llm-feeds.mjs --public-dir public_site --kind antique && npm run build:profile-hydration-feed",
        "repair:faq-schema": "node ./scripts/repair-faq-schema.mjs --public-dir public_site",
        "repair:internal-location-links": "node ./scripts/repair-internal-location-links.mjs --public-dir public_site",
        "repair:canonical-article-links": "node ./scripts/rewrite-canonical-article-links.mjs --public-dir public_site --write",
    "repair:provider-discovery-graph": "node ./scripts/apply-provider-discovery-graph.mjs --public-dir public_site --write",
    "repair:limited-provider-artwork": "node ./scripts/normalize-limited-provider-artwork.mjs --public-dir public_site --manifest data/provider-publication-manifest.json --write",
    "repair:static-city-heroes": "node ./scripts/normalize-static-city-heroes.mjs --public-dir public_site --write",
    "repair:static-authoritative-city-shells": "node ./scripts/migrate-static-authoritative-city-shells.mjs --public-dir public_site --write",
    "repair:city-provider-comparisons": "node ./scripts/apply-city-provider-comparison-modules.mjs --public-dir public_site --manifest data/provider-publication-manifest.json --write",
    "repair:city-question-evidence": "node ./scripts/enforce-city-question-evidence.mjs --public-dir public_site --policy data/city-question-evidence-policy.json --write",
    "repair:unlinked-city-cards": "node ./scripts/quarantine-unlinked-city-cards.mjs --public-dir public_site --write",
        "repair:short-mobile-compositing": "node ./scripts/repair-short-mobile-compositing.mjs --public-dir public_site",
        "env:check": "node ./scripts/env-check.mjs",
        "publish": "node -e \"console.error('Publishing is disabled here. Use the standard VPS deploy helper for antique-appraiser-directory.'); process.exit(1)\"",
        "publish:patch": "node -e \"console.error('Deprecated: use the standard VPS deploy helper for antique-appraiser-directory.'); process.exit(1)\"",
        "deploy": "node -e \"console.error('Deployment is disabled here. Use the standard VPS deploy helper for antique-appraiser-directory.'); process.exit(1)\"",
        "seo:title-tuning": "node ./scripts/gsc-weekly-title-tuning.mjs --days 28",
        "seo:location-ctr-cohort": "node ./scripts/gsc-location-ctr-cohort.mjs"
    },
    "dependencies": {
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.344.0",
        "posthog-js": "^1.304.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-helmet-async": "^2.0.4",
        "react-router-dom": "^6.22.3",
        "tailwind-merge": "^3.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.1",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^20.17.19",
        "@types/react": "^18.3.5",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.18",
        "axios": "^1.8.1",
        "chalk": "^5.3.0",
        "eslint": "^9.9.1",
        "eslint-plugin-react-hooks": "^5.1.0-rc.0",
        "eslint-plugin-react-refresh": "^0.4.11",
        "express": "^4.18.3",
        "fs-extra": "^11.3.0",
        "glob": "^8.1.0",
        "globals": "^15.9.0",
        "jsdom": "^24.0.0",
        "node-fetch": "^2.7.0",
        "open": "^10.0.3",
        "postcss": "^8.4.35",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.3.0",
        "vite": "^5.4.2"
    }
}
